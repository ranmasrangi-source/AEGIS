# ============================================================================
# AEGIS XAU — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ============================================================================
# SECURITY RULE: Variable names only. Never commit real secrets, tokens, or
# private keys into this file or any tracked file.
# ============================================================================

# Server Runtime
NODE_ENV=
PORT=
APP_URL=

# Single-Owner Identity Lock (Founder Decisions & V4.1 Section 6)
OWNER_EMAIL=
OWNER_UID=

# Phase 1 Execution & Mode Lock (Must remain false in Phase 1)
LIVE_TRADING_ENABLED=
ALLOWED_SYMBOL=

# Telemetry Cryptographic Verification (Decision Register OS-11, OS-7, EA-5)
# TODO(OS-11): Configurable signing scheme (HMAC_SHA256 | ASYMMETRIC_ED25519 | ASYMMETRIC_RSA_SHA256)
TELEMETRY_SIGNING_SCHEME=
EA_DEMO_KEY_ID=
EA_DEMO_SHARED_SECRET=
CLOCK_SKEW_TOLERANCE_SEC=
HEARTBEAT_STALE_THRESHOLD_SEC=

# Firebase Admin / Project Configuration
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
